; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot To Steam"
run/main_scene="uid://ccwbs581hfimh"
config/features=PackedStringArray("4.7")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.08235, 0.08235, 0.08235, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://r8phqwxmscr4"

[audio]

buses/default_bus_layout="uid://ci61fr1dqsshd"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "yellow",
"res://features/": "green",
"res://public/": "orange",
"res://src/": "blue",
"res://src/app/": "red",
"res://src/components/": "green",
"res://src/components/menues/": "red",
"res://src/features/": "purple",
"res://src/routes/": "teal"
}

[global_group]

Player="Player is in this group used for fidning it efficiently"
Loot="if loot is in group"
Navigation=""
MenuAnimation=""
Enemy="Target group to find targets the player can target"

[gui]

theme/custom="uid://b56qgya4xh3s2"

